# Ateliux local homologation environment.
# Copy to .env.docker and replace placeholders. Do not commit .env.docker.

# Use test for local homologation when localhost origins are present.
# If you change to staging/production, remove localhost origins from CORS_ORIGINS.
NODE_ENV=test
PORT=3001
API_PREFIX=api

POSTGRES_DB=ateliux_local_homolog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://postgres:change-me-postgres-password@postgres:5432/ateliux_local_homolog?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change-me-access-secret-32
JWT_REFRESH_SECRET=change-me-refresh-secret-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=change-me-cookie-secret-32-chars
COOKIE_DOMAIN=

# For Vercel -> ngrok authenticated flows use:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
#
# For localhost-only browser flows use:
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
AUTH_DEBUG=false

CLIENT_APP_URL=https://URL-REAL-DO-FRONTEND-VERCEL
ADMIN_APP_URL=https://URL-REAL-DA-ADMIN-VERCEL
CORS_ORIGINS=https://URL-REAL-DO-FRONTEND-VERCEL,https://URL-REAL-DA-ADMIN-VERCEL,http://localhost:3000,http://localhost:3002

ALLOW_DEMO_SEED=false
AUTO_MIGRATE_ON_START=false
AUTO_BOOTSTRAP_ADMIN_ON_START=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=ateliux-local-homolog

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Ateliux <no-reply@ateliux.com.br>
# Backward-compatible alias for deployment platforms that use this name.
SMTP_FROM=Ateliux <no-reply@ateliux.com.br>

UPLOAD_MAX_GLOBAL_SIZE_MB=100
ADMIN_UPLOAD_MAX_SIZE_MB=100
BLOG_IMAGE_UPLOAD_MAX_SIZE_MB=8
UPLOAD_AUTO_APPROVE_ADMIN_SAFE_CONTEXTS=true

RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# Optional ngrok profile. Do not commit a real NGROK_AUTHTOKEN.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=aubrielle-wroth-shae.ngrok-free.dev
